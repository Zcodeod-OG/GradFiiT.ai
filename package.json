{
  "name": "gradfit-workspace",
  "private": true,
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix-colors cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && ..\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "mobile:install": "cd mobile && npm install",
    "mobile:sync": "cd mobile && npm run sync",
    "mobile:ios": "cd mobile && npm run ios",
    "mobile:android": "cd mobile && npm run android"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
